# ==============================================================================
# UPTOSKILL Intern Portal - Environment Configuration
# ==============================================================================

# Database Connection (MongoDB)
# Example: mongodb+srv://username:password@cluster.mongodb.net/uptoskill_prod
MONGO_URI=mongodb://127.0.0.1:27017/intern_portal

# Session Authentication & Security
# Minimum 32-character random string for signing JWT tokens
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret_key_min_32_chars

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port
PORT=3000

# Frontend Base URL (For CORS whitelist, email verification links, QR codes)
FRONTEND_URL=https://intern-portal.uptoskill.com

# Brevo SMTP Configuration (Required for password resets, alerts, certificate emails)
BREVO_SMTP_USER=7x4b9a@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-your-long-smtp-key-here
BREVO_SENDER_EMAIL=support@uptoskill.com
EMAIL_FROM=UPTOSKILL Notifications <support@uptoskill.com>

# Optional Secondary Email Provider (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=UPTOSKILL <onboarding@resend.dev>

# Scheduled Jobs Configuration
# Timezone used for daily cron tasks (Default: Asia/Kolkata)
JOB_TIMEZONE=Asia/Kolkata
JOBS_TIMEZONE=Asia/Kolkata

# Retention & Status Job Dry-Run Mode
# Set to 'true' to log actions without mutating data or sending emails
DRY_RUN=false

# Support Chatbot API Integration (Task M)
# Backend proxy destination for Web Support Chatbot service
CHATBOT_API_URL=http://127.0.0.1:8000/api/chat

# Initial Admin User Provisioning (scripts/createAdmin.js)
ADMIN_EMAIL=admin@uptoskill.com
ADMIN_PASSWORD=ChangeMeOnFirstLogin123!
ADMIN_NAME=UPTOSKILL System Admin

# Optional Redis Cache (Falls back to in-memory caching if omitted)
REDIS_URL=redis://127.0.0.1:6379

# Certificate Storage Configuration (Persistent Volume or Cloud Mount)
STORAGE_PATH=
